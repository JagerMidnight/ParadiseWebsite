{
  "version": 2,
  "rewrites": [
    {
      "source": "/",
      "destination": "/public/pages/home/index.html"
    },
    {
      "source": "/:page",
      "destination": "/public/pages/:page/index.html"
    },
    {
      "source": "/assets/:file",
      "destination": "/public/assets/:file"
    }
  ]
}
